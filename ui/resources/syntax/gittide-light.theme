{
    "_comments": [
        "GitTide Light — syntax theme derived from the app's design tokens",
        "(docs/spec/design/design.md). Realises the D45 upgrade path: colours",
        "come from a data file, not hex literals in a widget. Keep in sync with",
        "ui/src/theme.cpp (lightTheme). Every text colour clears 4.5:1 on #F5F5F5."
    ],
    "metadata": {
        "name": "GitTide Light",
        "revision": 1,
        "license": "SPDX-License-Identifier: MIT"
    },
    "text-styles": {
        "Normal":         { "text-color": "#212121" },
        "Keyword":        { "text-color": "#0B60C4", "bold": true },
        "Function":       { "text-color": "#7A5C00" },
        "Variable":       { "text-color": "#212121" },
        "ControlFlow":    { "text-color": "#0B60C4", "bold": true },
        "Operator":       { "text-color": "#55555C" },
        "BuiltIn":        { "text-color": "#127D6B" },
        "Extension":      { "text-color": "#127D6B" },
        "Preprocessor":   { "text-color": "#BC4C00" },
        "Attribute":      { "text-color": "#7A5C00" },
        "Char":           { "text-color": "#1A7F37" },
        "SpecialChar":    { "text-color": "#8A5D00" },
        "String":         { "text-color": "#1A7F37" },
        "VerbatimString": { "text-color": "#1A7F37" },
        "SpecialString":  { "text-color": "#8A5D00" },
        "Import":         { "text-color": "#BC4C00" },
        "DataType":       { "text-color": "#127D6B" },
        "DecVal":         { "text-color": "#8A5D00" },
        "BaseN":          { "text-color": "#8A5D00" },
        "Float":          { "text-color": "#8A5D00" },
        "Constant":       { "text-color": "#8A5D00" },
        "Comment":        { "text-color": "#6E6E73", "italic": true },
        "Documentation":  { "text-color": "#6E6E73", "italic": true },
        "Annotation":     { "text-color": "#5F5F5F" },
        "CommentVar":     { "text-color": "#5F5F5F" },
        "RegionMarker":   { "text-color": "#0B60C4" },
        "Information":     { "text-color": "#0969DA" },
        "Warning":        { "text-color": "#9A6700" },
        "Alert":          { "text-color": "#CF222E", "bold": true },
        "Error":          { "text-color": "#CF222E", "underline": true },
        "Others":         { "text-color": "#212121" }
    },
    "editor-colors": {
        "BackgroundColor": "#F5F5F5",
        "CodeFolding": "#EAEAEA",
        "BracketMatching": "#EAEAEA",
        "CurrentLine": "#FFFFFF",
        "IconBorder": "#F5F5F5",
        "IndentationLine": "#E0E0E0",
        "LineNumbers": "#6E6E73",
        "CurrentLineNumber": "#212121",
        "MarkBookmark": "#1976D2",
        "MarkBreakpointActive": "#CF222E",
        "MarkBreakpointReached": "#9A6700",
        "MarkBreakpointDisabled": "#BC4C00",
        "MarkExecution": "#6E6E73",
        "MarkWarning": "#9A6700",
        "MarkError": "#CF222E",
        "ModifiedLines": "#9A6700",
        "ReplaceHighlight": "#1A7F37",
        "SavedLines": "#1A7F37",
        "SearchHighlight": "#1976D2",
        "TextSelection": "#EAEAEA",
        "Separator": "#E0E0E0",
        "SpellChecking": "#CF222E",
        "TabMarker": "#6E6E73",
        "TemplateBackground": "#FFFFFF",
        "TemplatePlaceholder": "#EAEAEA",
        "TemplateFocusedPlaceholder": "#EAEAEA",
        "TemplateReadOnlyPlaceholder": "#EAEAEA",
        "WordWrapMarker": "#6E6E73"
    }
}
