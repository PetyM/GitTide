{
    "_comments": [
        "GitTide Dark — syntax theme derived from the app's design tokens",
        "(docs/spec/design/design.md). Realises the D45 upgrade path: colours",
        "come from a data file, not hex literals in a widget. Keep in sync with",
        "ui/src/theme.cpp (darkTheme). Every text colour clears 4.5:1 on #1C1C1E."
    ],
    "metadata": {
        "name": "GitTide Dark",
        "revision": 1,
        "license": "SPDX-License-Identifier: MIT"
    },
    "text-styles": {
        "Normal":         { "text-color": "#E4E4E6" },
        "Keyword":        { "text-color": "#6FB4F0", "bold": true },
        "Function":       { "text-color": "#DCDCAA" },
        "Variable":       { "text-color": "#E4E4E6" },
        "ControlFlow":    { "text-color": "#6FB4F0", "bold": true },
        "Operator":       { "text-color": "#C0C0C5" },
        "BuiltIn":        { "text-color": "#4EC9B0" },
        "Extension":      { "text-color": "#4EC9B0" },
        "Preprocessor":   { "text-color": "#E08A5B" },
        "Attribute":      { "text-color": "#DCDCAA" },
        "Char":           { "text-color": "#7BC77D" },
        "SpecialChar":    { "text-color": "#E0A64B" },
        "String":         { "text-color": "#7BC77D" },
        "VerbatimString": { "text-color": "#7BC77D" },
        "SpecialString":  { "text-color": "#E0A64B" },
        "Import":         { "text-color": "#E08A5B" },
        "DataType":       { "text-color": "#4EC9B0" },
        "DecVal":         { "text-color": "#E0A64B" },
        "BaseN":          { "text-color": "#E0A64B" },
        "Float":          { "text-color": "#E0A64B" },
        "Constant":       { "text-color": "#E0A64B" },
        "Comment":        { "text-color": "#8E8E93", "italic": true },
        "Documentation":  { "text-color": "#8E8E93", "italic": true },
        "Annotation":     { "text-color": "#A6A6AB" },
        "CommentVar":     { "text-color": "#A6A6AB" },
        "RegionMarker":   { "text-color": "#6FB4F0" },
        "Information":     { "text-color": "#388BFD" },
        "Warning":        { "text-color": "#D29922" },
        "Alert":          { "text-color": "#F85149", "bold": true },
        "Error":          { "text-color": "#F85149", "underline": true },
        "Others":         { "text-color": "#E4E4E6" }
    },
    "editor-colors": {
        "BackgroundColor": "#1C1C1E",
        "CodeFolding": "#333336",
        "BracketMatching": "#333336",
        "CurrentLine": "#262628",
        "IconBorder": "#1C1C1E",
        "IndentationLine": "#333336",
        "LineNumbers": "#8E8E93",
        "CurrentLineNumber": "#E4E4E6",
        "MarkBookmark": "#42A5F5",
        "MarkBreakpointActive": "#F85149",
        "MarkBreakpointReached": "#D29922",
        "MarkBreakpointDisabled": "#DB6D28",
        "MarkExecution": "#8E8E93",
        "MarkWarning": "#D29922",
        "MarkError": "#F85149",
        "ModifiedLines": "#D29922",
        "ReplaceHighlight": "#3FB950",
        "SavedLines": "#3FB950",
        "SearchHighlight": "#42A5F5",
        "TextSelection": "#333336",
        "Separator": "#3D3D40",
        "SpellChecking": "#F85149",
        "TabMarker": "#8E8E93",
        "TemplateBackground": "#262628",
        "TemplatePlaceholder": "#333336",
        "TemplateFocusedPlaceholder": "#333336",
        "TemplateReadOnlyPlaceholder": "#333336",
        "WordWrapMarker": "#8E8E93"
    }
}
